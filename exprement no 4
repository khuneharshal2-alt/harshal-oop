#include <iostream>
#include <string>

using namespace std;
class student
{
    public:
    string name;
    int rollno;

    student(string name, int rollno) 
    {
        this->name =name;
        this->rollno =rollno;

    }
    void display()
    {
        cout << "name of student is:  "<<name<<endl;
        cout << "rollno of student is: "<<rollno<<endl;

    }

};
int main()
{
    student s1("Harshal", 17);
    s1.display();
    return 0;
}
